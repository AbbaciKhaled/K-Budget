# MongoDB connection string (Atlas or local)
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/k-budget?retryWrites=true&w=majority"

# Auth.js secret — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"

# Needed when running behind a proxy / in production
AUTH_TRUST_HOST=true

# Set to false to make your instance private: no new accounts, existing ones can still log in.
SIGNUP_ENABLED=true
